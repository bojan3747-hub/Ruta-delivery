# PostgreSQL connection string (Supabase or Neon in production, local Postgres in dev)
DATABASE_URL="postgresql://user:password@localhost:5432/ruta"
SESSION_SECRET="replace-with-a-long-random-string"

# Mapbox public token (pretraga adrese + mapa u formi za novu pošiljku).
# Bez ovoga forma i dalje radi, samo bez pretrage/mape — obično polje za tekst.
NEXT_PUBLIC_MAPBOX_TOKEN=""

# Faza 20: Google SSO za klijente ("Nastavi sa Google" na /prijava i
# /registracija). Bez ovoga dugme i dalje postoji, ali klik na njega vraća
# korisnika nazad sa porukom da prijava preko Google-a nije podešena —
# aplikacija ne puca. Dobija se u Google Cloud Console (OAuth client ID,
# tip "Web application"); kao "Authorized redirect URI" upiši tačno
# https://ruta-dostava.rs/auth/google/callback (i http://localhost:3100/auth/google/callback
# ako se ikad pokreće lokalno).
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Faza 21: Web Push notifikacije za klijente (nova ponuda, promena statusa
# porudžbine) — direktno preko Push API-ja iz browsera, bez spoljne usluge.
# Bez ovoga aplikacija i dalje radi normalno, samo se ne šalju push
# notifikacije (tiho se preskaču, vidi pushConfigured() u src/lib/push.ts).
# Generiše se JEDNOM komandom `npx web-push generate-vapid-keys` i ostaje
# isto — nije tajna po korisniku, jedan par ključeva važi za celu
# aplikaciju. NEXT_PUBLIC_VAPID_PUBLIC_KEY mora biti IDENTIČAN
# VAPID_PUBLIC_KEY (javni ključ se šalje i na server i u browser kod).
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:info@ruta-dostava.rs"
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
